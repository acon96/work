{
  "name": "work-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Hardened Docker sandbox for AI agent development and research tasks",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "extensions/system-prompt",
      "extensions/network-mode",
      "extensions/scheduler",
      "extensions/todo",
      "extensions/llama-swap",
      "extensions/superagent",
      "extensions/chat-titles"
    ],
    "skills": [
      "skills/notify",
      "skills/superagent",
      "skills/wiki-js",
      "skills/pi-harness"
    ]
  },
  "dependencies": {
    "@amartinr/pi-searxng": "1.0.3",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@jmfederico/pi-web": "1.202608.1",
    "pi-lens": "3.8.71",
    "pi-smart-fetch": "0.3.12"
  }
}
