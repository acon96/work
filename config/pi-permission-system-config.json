{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      ".env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow"
    },
    "external_directory_read": { 
      "/workspace/*": "allow"
    },
    "path_write": {
      "~/.ssh/*": "deny",
      "~/.git-credentials": "deny",
      "~/.pi/agent/extensions/pi-sandbox/config.json": "deny",
      "~/.pi/agent/extensions/pi-permission-system/config.json": "deny",
      "~/.pi/agent/web-search.json": "deny",
      "~/.pi/agent/settings.json": "deny",
      "~/.pi/agent/models.json": "deny"
    },
    "mcp": { 
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny"
    }
  }
}
